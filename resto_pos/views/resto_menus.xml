<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- ACTION: "open the ingredient cards in a list, click one to see its form"-->
    <record id="resto_ingredient_action" model="ir.actions.act_window">
        <field name="name">Ingredients</field>
        <field name="res_model">resto.ingredient</field>
        <field name="view_mode">list,form</field>
    </record>

    <record id="resto_table_action" model="ir.actions.act_window">
        <field name="name">Tables</field>
        <field name="res_model">resto.table</field>
        <field name="view_mode">list,form</field>
    </record>

    <record id="resto_order_action" model="ir.actions.act_window">
        <field name="name">Orders</field>
        <field name="res_model">resto.order</field>
        <field name="view_mode">list,form</field>
    </record>

    <record id="resto_menu_item_action" model="ir.actions.act_window">
        <field name="name">Menu Items</field>
        <field name="res_model">resto.menu.item</field>
        <field name="view_mode">list,form</field>
    </record>

    <record id="resto_stock_lot_action" model="ir.actions.act_window">
        <field name="name">Stock Lots</field>
        <field name="res_model">resto.stock.lot</field>
        <field name="view_mode">list</field>
    </record>

    <record id="resto_purchase_action" model="ir.actions.act_window">
        <field name="name">Purchases</field>
        <field name="res_model">resto.purchase</field>
        <field name="view_mode">list,form</field>
    </record>


    <!-- MENUITEM: "top-level app, then a sub-item that runs the action"-->
    <menuitem id="resto_menu_root" name="Resto POS"/>
    <menuitem id="resto_menu_tables"
            name="Tables"
            parent="resto_menu_root"
            action="resto_table_action"
            sequence="1"/>
    <menuitem id="resto_menu_orders"
            name="Orders"
            parent="resto_menu_root"
            action="resto_order_action"
            sequence="2"/>
    <menuitem id="resto_menu_items"
            name="Menu Items"
            parent="resto_menu_root"
            action="resto_menu_item_action"/>
    <menuitem id="resto_menu_ingredients"
            name="Ingredients"
            parent="resto_menu_root"
            action="resto_ingredient_action"/>
    <menuitem id="resto_menu_stock_lots"
            name="Stock Lots"
            parent="resto_menu_root"
            action="resto_stock_lot_action"/>
    <menuitem id="resto_menu_purchase"
            name="Purchases"
            parent="resto_menu_root"
            action="resto_purchase_action"/>
</odoo>
