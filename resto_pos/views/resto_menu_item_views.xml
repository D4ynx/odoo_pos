<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="resto_menu_item_view_list" model="ir.ui.view">
        <field name="name">resto.menu.item.view.list</field>
        <field name="model">resto.menu.item</field>
        <field name="arch" type="xml">
            <list>
                <field name="name"/>
                <field name="price"/>
                <!-- add category here in the future-->
            </list>
        </field>
    </record>

    <record id="resto_menu_item_view_form" model="ir.ui.view">
        <field name="name">resto.menu.item.view.form</field>
        <field name="model">resto.menu.item</field>
        <field name="arch" type="xml">
            <form>
                <sheet>
                    <group>
                        <field name="name"/>
                        <field name="price"/>
                        <!-- add category here in the future-->
                    </group>
                </sheet>
            </form>
        </field>
    </record>
</odoo>
