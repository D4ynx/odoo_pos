<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="resto_menu_item_view_list" model="ir.ui.view">
        <field name="name">resto.menu.item.view.list</field>
        <field name="model">resto.menu.item</field>
        <field name="arch" type="xml">
            <list>
                <field name="name"/>
                <field name="currency_id" column_invisible="1"/>
                <field name="price"/>
                <field name="category_ids" widget="many2many_tags"/>
            </list>
        </field>
    </record>

    <record id="resto_menu_item_view_form" model="ir.ui.view">
        <field name="name">resto.menu.item.view.form</field>
        <field name="model">resto.menu.item</field>
        <field name="arch" type="xml">
            <form>
                <sheet>
                    <group>
                        <field name="name"/>
                        <field name="currency_id" invisible="1"/>
                        <field name="price"/>
                        <field name="category_ids" widget="many2many_tags"/>
                    </group>
                    <field name="recipe_line_ids">
                        <list editable="bottom">
                            <field name="ingredient_id"/>
                            <field name="qty"/>
                            <field name="uom_id"/>
                        </list>
                    </field>
                </sheet>
            </form>
        </field>
    </record>
</odoo>
