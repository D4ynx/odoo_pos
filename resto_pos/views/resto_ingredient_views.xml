<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="resto_ingredient_view_list" model="ir.ui.view">
        <field name="name">resto.ingredient.view.list</field>
        <field name="model">resto.ingredient</field>
        <field name="arch" type="xml">
            <list decoration-danger="min_qty > qty_on_hand">
                <field name="name"/>
                <field name="uom_id"/>
                <field name="qty_on_hand"/>
                <field name="min_qty"/>
            </list>
        </field>
    </record>

    <record id="resto_ingredient_view_form" model="ir.ui.view">
        <field name="name">resto.ingredient.view.form</field>
        <field name="model">resto.ingredient</field>
        <field name="arch" type="xml">
            <form>
                <sheet>
                    <group>
                        <field name="name"/>
                        <field name="uom_id"/>
                        <field name="qty_on_hand"/>
                        <field name="min_qty"/>
                    </group>
                </sheet>
            </form>
        </field>
    </record>
</odoo>
